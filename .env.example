# Travel Guide — environment variables (copy to .env.local). No secrets are required to run the demo.

# Optional: HTTPS endpoint that receives "Request a Quote" submissions as JSON (POST).
# Leave empty to keep quote requests saved locally in the visitor's browser only.
VITE_QUOTE_ENDPOINT=

# Optional: endpoint returning live display-currency rates, e.g. {"base":"INR","date":"2026-10-26","rates":{"USD":0.012}}
# Leave empty to use the editable illustrative reference rates shown in the planner.
VITE_FX_ENDPOINT=

# Optional: disable live Wikipedia/Wikimedia Commons media lookups (true = use illustrated fallbacks only).
VITE_DISABLE_REMOTE_MEDIA=false

# ——— Live flight offers (server-side only; set in your hosting provider, never in VITE_ vars) ———
# FLIGHTS_PROVIDER=amadeus            # or: duffel
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test                    # "production" for real fares
# DUFFEL_ACCESS_TOKEN=

# ——— Firebase (Cloud Firestore) for quote requests ———
# Web app config from Firebase console → Project settings → Your apps. These identify the
# project and are public by design; firestore.rules only lets visitors create requests.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=
